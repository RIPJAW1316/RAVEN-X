# ----------------------------------------------------- RAVEN-X runtime ----
# SQLite database and its write-ahead log / shared-memory sidecars. The
# sidecars hold recent page images, so committing them leaks data the .db
# itself may no longer contain.
data/*.db
data/*.db-wal
data/*.db-shm
data/reports/*
!data/reports/.gitkeep
raven_x.db
raven_x.db-wal
raven_x.db-shm
logs/*.log
raven_x.log
*.log
ml_models/*.pkl
ml_models/**/model.pkl
scan_history.json

